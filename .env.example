# 1C Benchmark Configuration

# Path to 1C Designer executable
DESIGNER_PATH=

# Path to 1C database
DATABASE_PATH=

# Path to configuration storage
CONFIG_STORAGE_PATH=

# Processing configuration
PROCESSING_NAME=SampleProcessor
USER_NAME=Admin

# LLM Provider configuration
# PROVIDER_TYPE selects the backend: anthropic | openrouter | vllm
# MODEL_NAME is a short label used in the output filename (data/output_trial8_<MODEL_NAME>.csv)
# MODEL_ID is the provider-specific model identifier
PROVIDER_TYPE=anthropic
MODEL_NAME=sonnet-4-5
MODEL_ID=claude-sonnet-4-5-20250929

# --- anthropic provider ---
ANTHROPIC_API_KEY=

# --- openrouter provider ---
OPENROUTER_API_KEY=
# Optional attribution headers sent to OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=1CBench

# --- vllm provider (local OpenAI-compatible endpoint, e.g. DeepSeek-V4-Pro over an SSH tunnel) ---
# Base URL of the vLLM endpoint, e.g. http://localhost:8123/v1 (required when PROVIDER_TYPE=vllm)
VLLM_BASE_URL=http://localhost:8123/v1
# vLLM ignores the key, but the OpenAI client needs a non-empty value (defaults to EMPTY)
VLLM_API_KEY=EMPTY

# Toggle the model's chain-of-thought (vllm provider only): true = reasoning on, false = off.
# When on, the trace is stored in the "thinking" column of the output CSV.
REASONING=false

